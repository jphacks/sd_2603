# Use mock for local development and CI.
AI_PROVIDER=mock
ALLOW_PAID_AI=false

# To use Jev locally, set AI_PROVIDER=jev and ALLOW_PAID_AI=true.
# Keep this key server-side; never prefix it with NEXT_PUBLIC_.
# AI_GATEWAY_API_KEY=your-gateway-key
# JEV_MODEL_ID=typesafe-ai/jev

# Recall.ai (server-only). The key belongs to this region only.
RECALL_API_KEY=
RECALL_REGION=ap-northeast-1
# From the same Recall workspace's API Keys & Secrets page.
# RECALL_WORKSPACE_VERIFICATION_SECRET=whsec_...
# Optional CLI default; use the session-specific URL shown in Focus settings.
# RECALL_CHAT_WEBHOOK_URL=https://your-app.example/api/recall/chat/session-id
# Optional short-lived Google OAuth token to read private Drive PDF/DOCX files.
# GOOGLE_DRIVE_ACCESS_TOKEN=

# Public HTTPS origin of this app, reachable by the Recall bot.
# FOCUS_PUBLIC_BASE_URL=https://your-app.example
# Required to create sessions outside localhost. Keep server-side.
# FOCUS_CONTROL_KEY=your-long-random-secret
# Production shared session storage (Upstash Redis REST).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
