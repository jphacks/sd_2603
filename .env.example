# Use mock for local development and CI.
AI_PROVIDER=mock
ALLOW_PAID_AI=false

# To use Jev locally, set AI_PROVIDER=jev and ALLOW_PAID_AI=true.
# Keep this key server-side; never prefix it with NEXT_PUBLIC_.
# AI_GATEWAY_API_KEY=your-gateway-key
# JEV_MODEL_ID=typesafe-ai/jev

# Recall.ai visual output (server-side only). Generate a random 32+ character control token.
# RECALL_API_KEY=your-recall-api-key
# RECALL_REGION=us-east-1
# RECALL_CONTROL_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
