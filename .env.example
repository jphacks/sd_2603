# Use mock for local development and CI.
AI_PROVIDER=mock
ALLOW_PAID_AI=false

# To use Jev locally, set AI_PROVIDER=jev and ALLOW_PAID_AI=true.
# Keep this key server-side; never prefix it with NEXT_PUBLIC_.
# AI_GATEWAY_API_KEY=your-gateway-key
# JEV_MODEL_ID=typesafe-ai/jev

# Recall.ai bot join/leave. The key belongs to this region only.
RECALL_API_KEY=
RECALL_REGION=ap-northeast-1

# Recall.ai visual output (server-side only). Generate a random 32+ character control token.
# RECALL_CONTROL_TOKEN=replace-with-a-random-secret-of-at-least-32-characters

# When set, the bot subscribes to Meet chat and pins a request for the agenda.
# Leave empty to join with no recording and no chat. The URL must be public https.
# RECALL_CHAT_WEBHOOK_URL=https://example.ngrok.app/api/recall/chat
# Workspace verification secret from Recall (starts with whsec_).
# RECALL_WEBHOOK_SECRET=whsec_replace-me
# Optional text model for turning chat text into the judge agenda.
# AGENDA_MODEL=anthropic/claude-haiku-5.5
