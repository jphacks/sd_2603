# Use mock for local development and CI.
AI_PROVIDER=mock
ALLOW_PAID_AI=false

# To use Jev locally, set AI_PROVIDER=jev and ALLOW_PAID_AI=true.
# Keep this key server-side; never prefix it with NEXT_PUBLIC_.
# AI_GATEWAY_API_KEY=your-gateway-key
# JEV_MODEL_ID=typesafe-ai/jev

# Recall.ai bot join/leave. The key belongs to this region only.
RECALL_API_KEY=
RECALL_REGION=ap-northeast-1
# Workspace verification secret (whsec_...). Real-time transcript webhooks are rejected without it.
RECALL_VERIFICATION_SECRET=
# Public URL of /api/recall/webhook. Required when the app sends a bot.
RECALL_WEBHOOK_URL=
