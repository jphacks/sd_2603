// Copy to config.h (ignored by git) and fill in.
#pragma once

#define WIFI_SSID "your-wifi"
#define WIFI_PASSWORD "your-password"

// No trailing slash. Use the LAN address of the PC running `npm run dev`
// (e.g. http://192.168.0.10:3000), or the deployed https:// URL.
#define SERVER_BASE "http://192.168.0.10:3000"

// Same value as the botId used by /api/recall/video.
#define SESSION_ID "00000000-0000-4000-8000-000000000000"

// Same value as DEVICE_TOKEN on the server (32+ characters).
#define DEVICE_TOKEN "replace-with-a-random-secret-of-at-least-32-characters"
